{
  "name": "workagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkAgent —— 自建生产级 Agent Harness。阶段 1：Headless Walking Skeleton。",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "cases/*",
    "tools/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx apps/cli/src/main.ts",
    "verify:endpoint-profile": "tsx apps/cli/src/verify/endpoint-profile.ts",
    "verify:pairing": "tsx apps/cli/src/verify/pairing.ts",
    "verify:resume": "tsx apps/cli/src/verify/resume.ts",
    "verify:compact": "tsx apps/cli/src/verify/compact.ts",
    "verify:persistence": "tsx apps/cli/src/verify/persistence.ts",
    "verify:budget": "tsx apps/cli/src/verify/budget.ts",
    "verify:crash": "tsx apps/cli/src/verify/crash.ts",
    "verify:drift": "tsx apps/cli/src/verify/drift.ts",
    "verify:tools": "tsx apps/cli/src/verify/tools.ts",
    "verify:artifact": "tsx apps/cli/src/verify/artifact.ts",
    "verify:progress": "tsx apps/cli/src/verify/progress.ts",
    "verify:scenarios": "tsx apps/cli/src/verify/scenarios.ts",
    "verify:all": "npm run verify:endpoint-profile && npm run verify:pairing && npm run verify:resume && npm run verify:compact && npm run verify:persistence && npm run verify:budget && npm run verify:crash && npm run verify:drift && npm run verify:tools && npm run verify:artifact && npm run verify:progress && npm run verify:scenarios",
    "eval:suite": "tsx eval/suite/index.ts",
    "probe:reasoning-tokens": "tsx apps/cli/src/verify/reasoning-tokens.ts",
    "probe:requirement-extraction": "tsx apps/cli/src/verify/requirement-extraction.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
