.idea

out
target
bin

# 凭证。根 .env 存着 deepseek / dashscope 两家的 API Key。
.env
.env.*
!.env.example

# CLI 未显式指定目录时使用的默认 workspace
node_modules
.workagent-workspace

# 一个 workspace 一套存储（<ws>/.workagent/）。workspace 可以是仓库内任意目录，
# 所以这一条不能只靠上面那个固定目录名兜。
.workagent/

# 跨 workspace 的注册表与 MCP 启动配置，不是源码。
.workagent-state

# eval:suite 的 trial artifact（trace / manifest / report.json）。
# 是证据不是源码 —— 要留档请显式复制到 评测/ 下。
.workagent-eval
