.idea

out
target
bin

# 凭证。根 .env 存着 deepseek / dashscope 两家的 API Key。
.env
.env.*
!.env.example

# 阶段 1 的默认 workspace，跑 CLI 时自动生成
node_modules
.workagent-workspace

# 一个 workspace 一套存储（<ws>/.workagent/）。workspace 可以是仓库内任意目录，
# 所以这一条不能只靠上面那个固定目录名兜。
.workagent/

# 每次 CLI 运行落一份 JSONL trace（--no-trace 可关）。
# 是诊断与评测的 artifact，不是源码 —— 要留证据请显式复制到 评测/ 下。
.workagent-runs

# 阶段 2：SQLite 库（transcript / run_specs / agent_spec_snapshots / runs）。
# 它是本机的 Runtime 状态，不是源码；-wal / -shm 是 WAL 模式的伴生文件。
.workagent-state

# eval:suite 的 trial artifact（trace / manifest / report.json）。
# 是证据不是源码 —— 要留档请显式复制到 评测/ 下。
.workagent-eval
