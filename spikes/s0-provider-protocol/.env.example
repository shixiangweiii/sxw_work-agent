# 复制为 .env 后填入。.env 已在 .gitignore 中，不会被提交。

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 模型 ID 全部可覆盖。默认值可能已过期 —— 先跑 p0 discovery 确认。
# 语义探针用的主力模型
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5

# 非语义探针（P7 超上下文 / P8 超长结果）用的便宜模型，控制花费
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001
OPENAI_CHEAP_MODEL=gpt-5-mini

# 推理 / 扩展思考探针用的模型（P2）。留空则复用主力模型。
ANTHROPIC_THINKING_MODEL=
OPENAI_REASONING_MODEL=

# 只打印将要发送的请求体，不真正调用 API。等价于 --dry-run。
DRY_RUN=0
